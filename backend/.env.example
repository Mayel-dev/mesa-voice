# Load these variables in your shell. This file is not automatically loaded.
# Generate: python -c "import secrets; print(secrets.token_hex(24))"
MESA_TOKEN=replace-with-a-random-token-at-least-32-characters
MESA_MODE=local
STT_MODEL=/absolute/path/to/faster-whisper-small
STT_LANGUAGE=es
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
PIPER_MODEL=/absolute/path/to/es_ES-davefx-medium.onnx
PIPELINE_TIMEOUT=115
# Optional JSON argv list; no shell expansion:
# PIPER_COMMAND_JSON=["/path/to/python", "-m", "piper"]
